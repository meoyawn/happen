{
  "$id": "https://raw.githubusercontent.com/meoyawn/happen/master/packages/config/schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Happen configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code_mode_tool_search": {
      "type": "boolean",
      "default": false,
      "description": "Enable ranked discovery of deferred tools in GPT code mode. Explicit thread settings take precedence."
    },
    "mcp_servers": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "allOf": [
          {
            "$ref": "#/definitions/server"
          },
          {
            "oneOf": [
              {
                "required": [
                  "command"
                ]
              },
              {
                "required": [
                  "url"
                ]
              }
            ],
            "dependencies": {
              "args": [
                "command"
              ],
              "cwd": [
                "command"
              ],
              "env": [
                "command"
              ],
              "inherit_env": [
                "command"
              ],
              "headers": [
                "url"
              ],
              "header_env": [
                "url"
              ],
              "oauth": [
                "url"
              ]
            }
          }
        ]
      }
    }
  },
  "description": "Global tool discovery and MCP server configuration. Project layers configure MCP servers; model and other host options are selected through their owning APIs.",
  "definitions": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "inherit_env": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^/?#@\\s]+(?:[/?][^#\\s]*)?$"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "header_env": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "legacy_fallback": {
          "type": "boolean"
        },
        "oauth": {
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "client_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "client_secret_env": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "token_endpoint_auth_method": {
                  "enum": [
                    "none",
                    "client_secret_basic",
                    "client_secret_post"
                  ]
                },
                "scopes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "callback_port": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                }
              },
              "dependencies": {
                "client_secret_env": [
                  "client_id"
                ],
                "token_endpoint_auth_method": [
                  "client_id"
                ]
              }
            }
          ]
        }
      }
    },
    "project": {
      "title": "Happen project MCP configuration",
      "description": "Project layers may override individual MCP server fields. Transports are validated after merging with global and ancestor layers.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp_servers": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "additionalProperties": {
            "$ref": "#/definitions/server"
          }
        }
      }
    }
  }
}
